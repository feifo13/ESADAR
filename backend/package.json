{
  "name": "esadar-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --import ./tests/setup-env.js --test",
    "test:customer-profile-db": "node scripts/customer-profile-db-smoke.mjs",
    "test:watch": "node --test --watch",
    "emails:preview": "node scripts/generate-email-previews.mjs",
    "images:backfill": "node scripts/backfill-article-image-variants.mjs",
    "images:backfill:dry-run": "node scripts/backfill-article-image-variants.mjs --dry-run",
    "db:backup": "node scripts/backup-db.mjs",
    "db:script": "node scripts/run-db-script.mjs",
    "test:db-runner": "node --test tests/mysql-script-runner.test.js",
    "test:operational-reset": "node --test tests/mysql-script-runner.test.js tests/operational-reset-contract.test.js",
    "test:ship-concurrency-db": "node scripts/order-ship-idempotency-db-smoke.mjs",
    "test:order-lock-stress-db": "node scripts/order-multiarticle-lock-stress-db.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mysql2": "^3.19.1",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.18.0",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  }
}
